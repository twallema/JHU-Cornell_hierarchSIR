)
# perform paired bootstrap
B <- 10000
boot_log_diff <- replicate(
B,
{
idx <- sample(seq_len(nrow(paired_immune)), replace = TRUE)
mean(paired_ED_visits$log_diff[idx])
}
)
# report results
ci <- quantile(boot_log_diff, c(0.025, 0.975))
result <- tibble(
